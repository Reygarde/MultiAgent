{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Platform": {
    "RouterAgentId": "RouterAgent",
    "FallbackAgentId": "GeneralAgent",
    "MaxConcurrentMissions": 1,
    "MaxTaskLength": 16000,
    "Models": [
      {
        "Id": "general",
        "Provider": "Ollama",
        "Name": "qwen3:4b",
        "ContextSize": 4096,
        "MaxOutputTokens": 1024,
        "Temperature": 0.2
      },
      {
        "Id": "coder",
        "Provider": "Ollama",
        "Name": "qwen2.5-coder:7b",
        "ContextSize": 4096,
        "MaxOutputTokens": 1536,
        "Temperature": 0.2
      }
    ],
    "Agents": [
      {
        "Id": "RouterAgent",
        "Description": "Classifie les missions et choisit un agent.",
        "ModelId": "general",
        "SystemPrompt": "Tu es un routeur. Choisis l'agent le plus adapte selon ses capacites. Justifie brievement en francais.",
        "Capabilities": [ "classification", "routing" ],
        "FallbackKeywords": []
      },
      {
        "Id": "DeveloperAgent",
        "Description": "Genere, explique et analyse du code C#, TypeScript, React, Discord et Twitch.",
        "ModelId": "coder",
        "SystemPrompt": "Tu es un developpeur senior C#, .NET, TypeScript, React et bots Discord/Twitch. Reponds en francais avec du code clair. Le code est fourni comme texte uniquement et n'est jamais execute.",
        "Capabilities": [ "C#", ".NET", "TypeScript", "React", "Discord", "Twitch", "code" ],
        "FallbackKeywords": [ "C#", "CSharp", ".NET", "TypeScript", "React", "Discord", "Twitch", "code", "API", "REST", "bot", "programm", "develop", "bug", "debug" ]
      },
      {
        "Id": "GeneralAgent",
        "Description": "Repond aux demandes generales et produit des explications.",
        "ModelId": "general",
        "SystemPrompt": "Tu es un assistant generaliste. Reponds clairement en francais et signale tes incertitudes.",
        "Capabilities": [ "explication", "redaction", "synthese", "questions generales" ],
        "FallbackKeywords": []
      }
    ]
  },
  "Studio": {
    "DataDirectory": "..\\StudioData",
    "DeveloperAgentId": "DeveloperAgent",
    "MaxMissions": 200,
    "MaxCorrectionAttempts": 2,
    "MissionTimeoutSeconds": 900,
    "GenerationContextSize": 8192,
    "GenerationMaxOutputTokens": 6000,
    "MaxFiles": 30,
    "MaxFileBytes": 65536,
    "MaxProjectBytes": 262144
  },
  "Sandbox": {
    "Enabled": false,
    "Image": "aiplatform-sandbox:net10",
    "TimeoutSeconds": 120,
    "MemoryMegabytes": 2048,
    "CpuCount": 2
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "RequestTimeoutSeconds": 180,
    "KeepAliveSeconds": 120,
    "UnloadPreviousModel": true
  }
}
